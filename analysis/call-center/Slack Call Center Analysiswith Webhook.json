      "id": "7d8c7c57-01c5-4f60-9c91-7f865082e649",
      "name": "Has Audio Files?"
    },
    {
      "parameters": {
        "jsCode": "// Process Slack file response and filter audio files\nconst files = $input.first().json.files;\n\nif (!files || files.length === 0) {\n  return [{ json: { audioFiles: [] } }];\n}\n\nconst audioFiles = files.filter(file => {\n  const mimeType = file.mimetype || '';\n  return mimeType.includes('audio') || \n         mimeType.includes('octet-stream') ||\n         file.name?.toLowerCase().endsWith('.wav') ||\n         file.name?.toLowerCase().endsWith('.mp3') ||\n         file.name?.toLowerCase().endsWith('.m4a') ||\n         file.name?.toLowerCase().endsWith('.ogg');\n});\n\nif (audioFiles.length > 0) {\n  const file = audioFiles[0];\n  return [{\n    json: {\n      fileId: file.id,\n      filename: file.name,\n      urlPrivate: file.url_private,\n      mimeType: file.mimetype,\n      timestamp: file.created,\n      user: file.user\n    }\n  }];\n}\n\nreturn [{ json: { audioFiles: [] } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2416,
        64
      ],
