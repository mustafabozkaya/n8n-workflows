      "id": "207b9013-0f14-47c1-a581-798aa65b70b6",
      "name": "ElevenLabs STT",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Convert ElevenLabs word-level output to conversational transcript\nconst words = $json.words;\n\nif (!words || words.length === 0) {\n  return [{\n    json: {\n      formattedTranscript: \"\",\n      error: \"No transcription data received\"\n    }\n  }];\n}\n\nconst sortedWords = words.sort((a, b) => a.start - b.start);\nlet transcript = \"\";\nlet currentSpeaker = null;\n\nfor (const word of sortedWords) {\n  const speakerId = word.speaker_id || 'unknown';\n  \n  if (currentSpeaker !== speakerId) {\n    if (transcript !== \"\") transcript += \"\\n\";\n    const formattedSpeaker = `Speaker ${speakerId.split('_')[1] || speakerId}`;\n    transcript += `${formattedSpeaker}: ${word.text}`;\n    currentSpeaker = speakerId;\n  } else {\n    transcript += ` ${word.text}`;\n  }\n}\n\nreturn [{\n  json: {\n    formattedTranscript: transcript,\n    wordCount: sortedWords.length,\n    speakers: [...new Set(words.map(w => w.speaker_id))].length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
