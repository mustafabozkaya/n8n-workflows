      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Format analysis results for Slack\nconst item = $input.first().json;\nconst output = item.output || item;\n\nconst sentimentEmoji = {\n  'Positive': '😊',\n  'Negative': '😞',\n  'Neutral': '😐'\n};\n\nconst actionItems = output.action_items || [];\nconst actionItemsFormatted = actionItems.length > 0 \n  ? actionItems.map(item => `• ${item}`).join('\\n')\n  : '• No action items identified';\n\nreturn [{\n  json: {\n    ...output,\n    sentiment_emoji: sentimentEmoji[output.client_sentiment] || '',\n    action_items_formatted: actionItemsFormatted,\n    filename: item.filename || 'Unknown',\n    duration: item.duration || 'N/A'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3776,
        64
      ],
      "id": "c55bb0ff-794d-4cc6-82a5-d8919a48a47b",
      "name": "Format Slack Message"
    },
    {
      "parameters": {
        "jsCode": "// Send error message to Slack via webhook\nconst error = $json.error || 'Unknown error occurred';\n\nreturn [{\n  json: {\n    text: `❌ *Call Analysis Failed*\n\nAn error occurred while analyzing the call recording:\n\n\\`\\`\\`${error}\\`\\`\\`\n\nPlease try again or contact support.`\n  }\n}];"
      },
