      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Processed = 0, Report geçerli ve image alanı boş olanları filtrele\nconst filtered = items.filter(item => {\n\n    const processed = item.json.Processed;\n    //const isProcessed = processed === 1 || true\n\n\n    // image alanı boş veya null\n   const isImageEmpty = !item.json.image_name || item.json.image_name.trim() === \"null\" ||  item.json.image_name.trim() === \"\";\n  \n   const isImageurls=  $input.first().json[\"@image\"] !=\"wrong report url\" && $input.first().json[\"@image2\"] !=\"wrong report url\"\n\n    // const ismanager = item.json[\"Yönetici Adı\"]  && $input.first().json[\"Yönetici Soyadı\"]\n    // Üç koşul da sağlanmalı\n  \n\n  \n    return  isImageEmpty &&  isImageurls;\n});\n\n// Filtrelenmiş sonuçlardan ilk 20 kaydı al\nconst first = filtered.slice(0, 15);\n\nreturn first;\n\n"
      },
