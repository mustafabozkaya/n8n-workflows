    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://194.5.236.83:8080/api/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-r1:latest\",\n  \"prompt\": \"Leiten Sie das Geschlecht für den Namen ab: {{ $json.firstNameForAI }}\\n\\nGeben Sie NUR gültiges JSON mit GENAU den folgenden Feldern und Formaten zurück:\\n{\\n    \\\"inferred_gender\\\": \\\"[abgeleitetes Geschlecht: 'Herr', 'Frau' oder 'Herr/Frau']\\\"\\n}\\n\\nGeben Sie NUR das JSON ohne zusätzlichen Text zurück.\",\n  \"system\": \"Sie sind ein KI-Assistent, der das Geschlecht anhand eines gegebenen Namens ableitet. Ihre Aufgabe ist es, das Geschlecht (Herr, Frau oder Herr/Frau) der Person basierend auf ihrem Vornamen zu bestimmen. Wenn der Name nicht angegeben wird oder das Geschlecht nicht sicher abgeleitet werden kann, geben Sie 'Herr/Frau' zurück.\",\n  \"stream\": false,\n  \"format\": \"json\",\n  \"raw\": false,\n  \"options\": {\n    \"temperature\": 0.5,\n    \"top_k\": 40,\n    \"top_p\": 0.9,\n    \"repeat_penalty\": 1.1,\n    \"seed\": 42,\n    \"num_predict\": 512\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        304
      ],
      "id": "74eaaa5a-b504-4036-b298-18f2c7dcf4b5",
      "name": "HTTP Request (AI Gender Inference)",
      "retryOnFail": true,
      "credentials": {
        "httpBasicAuth": {
          "id": "aPoaTX1vb3cPgkSg",
          "name": "ollama basic "
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Önceki düğümden gelen lead verisini al\nconst lead = $(\"MySQL\").first().json\nlet firstNameForAI = 'null'; // AI'ya gönderilecek ilk isim\nlet emailForAI = null;         // AI'ya gönderilecek e-posta (eğer gerekirse)\n\n// 1. manager1 alanını kontrol et\nif (lead.manager1 && typeof lead.manager1 === 'string' && lead.manager1.trim() !== '') {\n    const parts = lead.manager1.trim().split(' ');\n    if (parts.length > 0) {\n        firstNameForAI = parts[0];\n    }\n}\n// 2. Eğer manager1'den isim bulunamadıysa, email1 alanından isim çıkarmayı dene\nelse if (lead.email1 && typeof lead.email1 === 'string' && lead.email1.trim() !== '') {\n    const email = lead.email1.trim();\n    const emailName = email.split('@')[0]; // @ öncesi kısmı al\n    \n    // Noktaları boşlukla değiştir ve her kelimenin baş harfini büyük yap\n    let formattedName = emailName\n        .replace(/\\./g, ' ')\n        .split(' ')\n        .map(word => {\n            // Eğer tek harf ise (örn. \"m\") -> \"M.\" formatına çevir\n            if (word.length === 1) {\n                return word.toUpperCase() + '.';\n            }\n            // Diğer durumda sadece baş harfi büyük yap\n            return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();\n        })\n        .join(' ');\n    \n    firstNameForAI = formattedName;\n}\n// 3. Eğer hala isim bulunamadıysa, name alanını kontrol et\n/**\n * \nelse if (firstNameForAI === 'unknown' && lead.name && typeof lead.name === 'string' && lead.name.trim() !== '') {\n    const parts = lead.name.trim().split(' ');\n    if (parts.length > 0) {\n        firstNameForAI = parts[0];\n    }\n}\n \n */\n\n\n// E-posta adresini temizle ve hazırla (eğer AI'ya göndermek isterseniz)\nif (lead.email1 && typeof lead.email1 === 'string' && lead.email1.trim() !== '') {\n    emailForAI = lead.email1.trim().replace(/\\[at\\]/gi, '@');\n}\n\n// Sonraki düğüme gönderilecek veriyi hazırla\nreturn [{\n    json: {\n        // Orijinal lead verisini koru\n        ...lead,\n        // AI'ya gönderilecek özel alanlar\n        firstNameForAI: firstNameForAI,\n        emailForAI: emailForAI\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        304
      ],
      "id": "d33b3dc7-6583-44a0-9644-028ca3377ca9",
      "name": "Code (Prepare Lead Data for AI)"
    },
    {
      "parameters": {
        "jsCode": "// Önceki düğümden (HTTP Request - AI Gender Inference) gelen veriyi al\n// Bu düğümün çıktısı genellikle tek bir öğe içerir.\nconst aiResponseItem = $input.first();\nconst aiResponseJson = aiResponseItem.json; // JSON objesini al\n\nlet parsedGenderData = { inferred_gender: 'unknown' }; // Varsayılan değer\n\n// 'response' alanının varlığını ve tipini kontrol et\n// AI'dan gelen yanıtın 'response' anahtarı altında bir string olarak geldiğini varsayıyoruz.\nif (aiResponseJson.response && typeof aiResponseJson.response === 'string') {\n    try {\n        // 'response' string'ini JSON objesine dönüştür\n        // JSON.parse'dan önce trim() kullanmak, string'in başındaki/sonundaki boşlukları/yeni satırları temizler.\n        const rawParsed = JSON.parse(aiResponseJson.response.trim());\n\n        // Eğer parse edilen objede 'inferred_gender' alanı varsa kullan, yoksa 'unknown' olarak kalır.\n        if (rawParsed.inferred_gender) {\n            parsedGenderData.inferred_gender = rawParsed.inferred_gender;\n        }\n    } catch (error) {\n        // JSON parse hatası durumunda konsola hata yazdır ve varsayılan değeri koru\n        console.error(\"Error parsing AI response JSON:\", error);\n        // Hata durumunda parsedGenderData zaten varsayılan 'unknown' değerini tutuyor olacak.\n    }\n}\n\n// Sonraki düğüme gönderilecek veriyi hazırla.\n// Bu düğümün çıktısı, sadece parse edilmiş cinsiyet bilgisini içermelidir.\n// Diğer lead verileri, Code (Prepare Lead Data for AI) düğümünden veya\n// doğrudan Code (Build Instantly Lead Body - Placeholder) düğümünde alınacaktır.\nreturn [{\n    json: {\n        inferred_gender: parsedGenderData.inferred_gender\n    }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        304
      ],
      "id": "116338f3-21e6-4651-a9a0-b2c02345c794",
      "name": "JSON (Parse AI Response)"
    },
    {
      "parameters": {
        "jsCode": "const item = $('Code (Prepare Lead Data for AI)').first();\nconst lead = item.json;\n\nconst item2= $('JSON (Parse AI Response)').first();\nconst j = item2.json;\n// Return item with updated JSON\nreturn {\n  ...lead,  // Spread the payload object directly\n  gender: j.inferred_gender\n};"
      },
