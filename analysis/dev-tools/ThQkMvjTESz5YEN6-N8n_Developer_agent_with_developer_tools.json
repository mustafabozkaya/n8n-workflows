      "name": "Yüklenen Dosyadan Metni Çıkar"
    },
    {
      "parameters": {
        "jsCode": "// Gelen veri, IF bloğu sayesinde her zaman tutarlı olacak.\n// Agent için veri hazırlama - Developer Tool formatında\nconst item = $input.first().json;\n\nconst userQuery = item.chatInput;\nconst fileContext = item.upload_file_context || '';\n\n// URL'leri kullanıcı sorgusundan ayıkla\nconst urlRegex = /https?:\\/\\/[^\\s]+/g;\nconst sources = userQuery.match(urlRegex) || [];\n\n// URL temizleyici - sadece query'den URL'leri çıkar\n\nconst cleanedQuery = item.chatInput.replace(urlRegex, '').trim();\n\n// n8n dokümanları URL'sini varsayılan olarak ekle\nif (!sources.includes('https://docs.n8n.io/glossary/')) {\n  sources.push('https://docs.n8n.io/glossary/');\n}\n\nlet addedFileContext = cleanedQuery\n\n// Dosya içeriği varsa, query'yi zenginleştir\nif (fileContext && fileContext.trim() !== '') {\n  addedFileContext += `\\n\\n--- UPLOADED FILE CONTEXT ---\\n${fileContext}`;\n}\n\n// Agent ve Developer Tool için veri hazırla\n// Builder'a gönderilecek son yükü oluştur\nconst builderPayload = {\n  cleaned_query: cleanedQuery,\n  added_file_context: addedFileContext, \n  upload_file_context: fileContext,\n  sources: sources\n};\n\n// Hem ajanın kullanması için orijinal sorguyu, hem de araca gönderilecek\n// işlenmiş veriyi aynı item içinde birleştir.\nreturn {\n \n  builderPayload: builderPayload\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
