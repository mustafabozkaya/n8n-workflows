    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.builderPayload}}",
        "options": {
          "systemMessage": "=# Overview\nYou are a helpful assistant. Your primary job is to take the user's request and call the 'Developer_Tool' to build an n8n workflow. \n\n- You will receive a query from the user, which may include text and context from an uploaded file.\n- Your only task is to call the `Developer_Tool` with the processed inputs you are given.\n- After the tool runs and returns a workflow link, present this link to the user in a clear, clickable format. For example: \"Your workflow is ready! You can view it here: [link]\"\n\nDo not attempt to answer the user's query yourself. Always use the tool."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
