    {
      "parameters": {
        "jsCode": "// Gelen tüm item'ları işliyoruz\nconst items = $input.all();\nconst results = [];\n\n// Her item için işlem yapıyoruz\nfor (const inputItem of items) {\n  const item = inputItem.json;\n  \n  // Webhook'tan gelen temel URL'yi alıyoruz\n  const baseUrl = item.url;\n  \n  // Eğer baseUrl boş ise, hata mesajı döndür\n  if (!baseUrl) {\n    results.push({\n      json: {\n        error: \"URL in incoming data is missing.\",\n        batch_id: item.batch_id || 'unknown'\n      }\n    });\n    continue;\n  }\n  \n  // target_paths, array olarak doğrudan veri içinde varsayılıyor\n  // Örn: [\"about\", \"services\", \"contact\"]\n  const targetPaths = item.target_paths;\n  \n  if (!Array.isArray(targetPaths) || targetPaths.length === 0) {\n    results.push({\n      json: {\n        error: \"Target paths are missing or not an array.\",\n        batch_id: item.batch_id || 'unknown'\n      }\n    });\n    continue;\n  }\n  \n  // Sonunda \"/\" varsa temizlenir\n  const cleanUrl = baseUrl.replace(/\\/$/, '');\n  \n  // Path'lerle birleştirilen URL'ler oluşturulur\n  const generatedUrls = targetPaths.map(path => `${cleanUrl}/${path}`);\n  \n  // Ana domain'i de ekle (isteğe bağlı)\n  generatedUrls.unshift(cleanUrl);\n  \n  // URL'leri 10'arlı gruplara ayır\n  const urlChunks = [];\n  for (let i = 0; i < generatedUrls.length; i += 10) {\n    urlChunks.push(generatedUrls.slice(i, i + 10));\n  }\n  \n  // Her chunk için ayrı bir output item oluştur\n  urlChunks.forEach((urlChunk, index) => {\n    results.push({\n      json: {\n        ...item,\n        urls: urlChunk,\n        batch_id: `${item.batch_id || 'batch'}_${index + 1}`,\n        chunk_index: index + 1,\n        total_chunks: urlChunks.length,\n        urls_in_chunk: urlChunk.length,\n        total_urls: generatedUrls.length\n      }\n    });\n  });\n}\n\n// n8n formatında çıktı veriyoruz\nreturn results;"
      },
