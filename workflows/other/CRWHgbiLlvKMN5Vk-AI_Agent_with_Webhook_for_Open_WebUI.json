    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst items = $input.all();\n\nreturn items.map(item => {\n  let text = '';\n  // Check if binary data exists and has a 'data' property\n  if (item.binary && item.binary.data0 && item.binary.data0.data) {\n    // Assuming 'data0.data' holds the base64 string\n    const base64String = item.binary.data0.data;\n    try {\n      text = Buffer.from(base64String, 'base64').toString('utf-8');\n    } catch (e) {\n      console.error('Error decoding base64:', e);\n      // Handle the error, perhaps by setting text to an empty string or an error message\n    }\n  } else {\n    // Handle cases where binary data might be missing or not in the expected format\n    console.warn('Binary data or expected data property not found for item:', item);\n    // You might want to set a default value or skip this item\n  }\n\n  return {\n    json: {\n      chattedText: text,\n      // You can add other properties here if needed\n      myNewField: 'someValue' // Example of adding the requested new field\n    }\n  };\n});\n"
      },
