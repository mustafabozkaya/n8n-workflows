{
  "name": "Multi-Agent Orchestration — Research → Writer → Editor",
  "nodes": [
    {
      "id": "webhook-topic",
      "name": "Konu Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [-600, 0],
      "parameters": { "path": "multi-agent", "httpMethod": "POST", "responseMode": "responseNode" }
    },
    {
      "id": "topic-validate",
      "name": "Konu Doğrulama",
      "type": "n8n-nodes-base.code",
      "position": [-400, 0],
      "parameters": {
        "jsCode": "// Validate topic + set up task tracking\nconst topic = $input.all()[0].json;\nif (!topic.title) throw new Error('Title required');\ntopic.id = 'task_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);\ntopic.status = 'started';\ntopic.created_at = new Date().toISOString();\nreturn [{ json: topic }];"
      }
    },
    {
      "id": "agent-researcher",
      "name": "Researcher Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [-200, -200],
      "parameters": {
        "modelType": "chat",
        "options": { "temperature": 0.3, "maxTokens": 3000 }
      }
    },
    {
      "id": "tool-web-search",
      "name": "Web Arama",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "parameters": {
        "workflowId": "web-search-sub",
        "description": "Web'de arama yap ve kaynak topla"
      }
    },
    {
      "id": "tool-academic-search",
      "name": "Akademik Arama",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "parameters": {
        "workflowId": "academic-search-sub",
        "description": "Akademik makalelerde arama yap"
      }
    },
    {
      "id": "merge-research",
      "name": "Arama Sonuçları Birleştir",
      "type": "n8n-nodes-base.merge",
      "position": [0, 0],
      "parameters": {
        "mode": "combineAll",
        "options": {}
      }
    },
    {
      "id": "agent-writer",
      "name": "Writer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [200, -200],
      "parameters": {
        "modelType": "chat",
        "options": { "temperature": 0.5, "maxTokens": 4000 }
      }
    },
    {
      "id": "tool-write-draft",
      "name": "Taslak Yaz",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "parameters": {
        "workflowId": "write-draft-sub",
        "description": "Araştırmaları kullanarak taslak yaz"
      }
    },
    {
      "id": "agent-editor",
      "name": "Editor Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [400, -200],
      "parameters": {
        "modelType": "chat",
        "options": { "temperature": 0.1, "maxTokens": 3000 }
      }
    },
    {
      "id": "tool-edit-review",
      "name": "Düzenle & Gözden Geçir",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "parameters": {
        "workflowId": "edit-review-sub",
        "description": "Taslaküzenle, dil bilgisi kontrolü yap"
      }
    },
    {
      "id": "output-multi-agent",
      "name": "Sonuç Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [600, 0],
      "parameters": {
        "schemaType": "jsonSchema",
        "jsonSchema": "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"final_article\":{\"type\":\"string\"},\"word_count\":{\"type\":\"number\"},\"sources\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"agent_chain\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"duration_ms\":{\"type\":\"number\"}}}},\"quality_score\":{\"type\":\"number\",\"minimum\":0,\"maximum\":10}},\"required\":[\"title\",\"final_article\",\"sources\"]}"
      }
    },
    {
      "id": "slack-multi-agent",
      "name": "Slack Bildirimi",
      "type": "n8n-nodes-base.slack",
      "position": [800, 0],
      "parameters": {
        "operation": "post",
        "channel": "#content-team",
        "text": "📝 Multi-Agent Tamam: {{ $json.title }} | Kalite: {{ $json.quality_score }}/10"
      }
    },
    {
      "id": "response-multi-agent",
      "name": "Cevap",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1000, 0],
      "parameters": {
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Konu Webhook": {
      "main": [[{ "node": "Konu Doğrulama", "type": "main", "index": 0 }]]
    },
    "Konu Doğrulama": {
      "main": [[{ "node": "Researcher Agent", "type": "main", "index": 0 }]]
    },
    "Researcher Agent": {
