      "ai_tool": [
        [{ "node": "Web Arama", "type": "ai_tool", "index": 0 }],
        [{ "node": "Akademik Arama", "type": "ai_tool", "index": 0 }]
      ],
      "main": [[{ "node": "Arama Sonuçları Birleştir", "type": "main", "index": 0 }]]
    },
    "Arama Sonuçları Birleştir": {
      "main": [[{ "node": "Writer Agent", "type": "main", "index": 0 }]]
    },
    "Writer Agent": {
      "ai_languageModel": [[{ "node": "OpenAI Chat Model", "type": "ai_languageModel", "index": 0 }]],
      "ai_tool": [[{ "node": "Taslak Yaz", "type": "ai_tool", "index": 0 }]],
      "main": [[{ "node": "Editor Agent", "type": "main", "index": 0 }]]
    },
    "Editor Agent": {
      "ai_languageModel": [[{ "node": "OpenAI Chat Model", "type": "ai_languageModel", "index": 0 }]],
      "ai_tool": [[{ "node": "Düzenle & Gözden Geçir", "type": "ai_tool", "index": 0 }]],
      "main": [[{ "node": "Sonuç Parser", "type": "main", "index": 0 }]]
    },
    "Sonuç Parser": {
      "main": [[{ "node": "Slack Bildirimi", "type": "main", "index": 0 }]]
    },
    "Slack Bildirimi": {
      "main": [[{ "node": "Cevap", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["multi-agent", "research", "writing", "editor", "orchestration", "content"]
