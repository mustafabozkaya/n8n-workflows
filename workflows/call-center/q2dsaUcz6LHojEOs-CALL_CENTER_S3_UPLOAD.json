      "name": "get call file",
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Her zaman bir item dön, böylece her dosya için işlem devam eder\nconst item = $input.first();\n\n// Gelen veriyi kontrol et\nconsole.log('Code noduna gelen veri:', JSON.stringify(item.json, null, 2));\n\n// callid değerini doğru şekilde al\nlet callid = '';\ntry {\n  // Farklı kaynaklardan callid bulmaya çalış\n  if (item.json.callid) {\n    callid = item.json.callid;\n    console.log('Callid doğrudan json\\'dan alındı:', callid);\n  } else if (item.json.Key && item.json.Key.includes('/')) {\n    // Key'den callid çıkar (calls/outbound/CALLID.wav)\n    const keyParts = item.json.Key.split('/');\n    const lastPart = keyParts[keyParts.length - 1];\n    callid = lastPart.split('.wav')[0]; // .wav uzantısını kaldır, diğer noktaları koru\n    console.log('Callid key\\'den alındı:', callid);\n  } else if (item.json.Location) {\n    // URL'den callid çıkar - tüm callid'yi koru (.1.1 gibi kısımlar dahil)\n    const match = item.json.Location.match(/\\/([\\-0-9.]+)\\.wav/);\n    if (match && match[1]) {\n      callid = match[1];\n      console.log('Callid Location\\'dan alındı:', callid);\n    }\n  } else {\n    // Get call file node'undan callid almaya çalış\n    try {\n      callid = $('get call file').first().json.callid;\n      console.log('Callid get call file\\'dan alındı:', callid);\n    } catch (e) {\n      console.log('Get call file\\'dan callid alınamadı:', e.message);\n    }\n  }\n} catch (error) {\n  console.log('callid alınamadı:', error.message);\n}\n\n// callid hala yoksa timestamp ekle\nif (!callid) {\n  callid = 'unknown-' + Date.now();\n  console.log('Uyarı: callid bulunamadı, geçici değer oluşturuldu:', callid);\n}\n\n// callDirection'ı belirle - Key veya Location'dan çıkar\nlet callDirection = 'unknown';\ntry {\n  if (item.json.callDirection) {\n    callDirection = item.json.callDirection;\n  } else if (item.json.Key && item.json.Key.includes('/')) {\n    callDirection = item.json.Key.includes('/inbound/') ? 'inbound' : 'outbound';\n  } else if (item.json.Location) {\n    callDirection = item.json.Location.includes('/inbound/') ? 'inbound' : 'outbound';\n  }\n} catch (error) {\n  console.log('callDirection belirlenemedi:', error.message);\n}\n\n// Dosya yolu oluştur\nconst s3Key = `calls/${callDirection}/${callid}.wav`;\nconsole.log('Oluşturulan S3 dosya yolu:', s3Key);\n\n// Metadata bilgilerini koru\nreturn [\n  {\n    json: {\n      ...item.json,\n      callid: callid, // callid ekle/güncelle\n      callDirection: callDirection,\n      Key: s3Key,\n      s3_uploaded: true,\n      s3_path: `s3://callintech/${s3Key}`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        -180
      ],
      "id": "c0ea0f5c-2664-431d-bc6f-1df43491014a",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// Binary veriyi ve URL'yi al\nconst item = $input.first();\nconst fileName = item.json.url || \"\";\nlet callDirection = \"\";\n\n// URL içinde inbound veya outbound kelimelerini ara (büyük/küçük harf duyarsız)\nif (fileName.toLowerCase().includes(\"inbound\")) {\n  callDirection = \"inbound\";\n} else if (fileName.toLowerCase().includes(\"outbound\")) {\n  callDirection = \"outbound\";\n} else {\n  // Eğer belirlenemezse varsayılan olarak inbound kabul et\n  callDirection = \"inbound\";\n}\n\n// Tüm binary datayı ve json'ı koru, sadece callDirection ekle\nreturn [\n  {\n    json: { ...item.json, callDirection },\n    binary: item.binary\n  }\n];\n"
      },
