      "parameters": {
        "jsCode": "// Process STT Error code from original\n// Hata durumunda oluşan verileri işleyen fonksiyon\nconst item = $input.first(); // Bu item IF STT/Conv Error? (True) -> Process Conversation'dan gelir\nlet callId = item.json.callid || 'unknown';\nlet errorMessage = item.json.error || 'Bilinmeyen STT/Conversation işleme hatası';\n\n// Hata bilgisini logla\nconsole.log(`İşleme hatası (STT/Conv): CallID=${callId}, Hata=${errorMessage}`); \n\nreturn [\n  {\n    json: {\n      callid: callId,\n      stt_processed: false, \n      error: true,\n      error_message: errorMessage.substring(0, 250) // Mesajı DB için kısalt\n    }\n  }\n];"
