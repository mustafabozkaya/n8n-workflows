    {
      "parameters": {
        "jsCode": "// Process Conversation code from original\n// Elevanlabs STT'den words değerini al\nlet words = [];\nlet sttError = null;\n\nconst inputItem = $input.first();\nif (inputItem.json.error) {\n  sttError = inputItem.json.error.message || 'ElevenLabs STT bilinmeyen hata';\n  console.log('Hata: elevanlabs STT node hatası:', sttError);\n} else {\n  try {\n    const elevenlabsOutput = inputItem.json;\n    if (elevenlabsOutput && elevenlabsOutput.words && Array.isArray(elevenlabsOutput.words)) {\n      words = elevenlabsOutput.words;\n    } else {\n      sttError = 'Transkripsiyon verisi (words dizisi) bulunamadı veya array değil';\n      console.log('Uyarı:', sttError);\n    }\n  } catch (error) {\n    sttError = 'elevanlabs STT çıktısı parse edilemedi: ' + error.message;\n    console.log('Hata:', sttError);\n  }\n}\n\n// Çağrı ID'sini al\nlet callid = 'unknown';\ntry {\n  callid = $('Download S3 File (Audio)').first().json.callid || 'unknown';\n} catch (error) {\n  console.log('Uyarı: callid Prepare S3 Download nodeundan alınamadı:', error.message);\n}\n\nif (sttError) {\n  return [\n    {\n      json: {\n        callid: callid,\n        conversation: [],\n        error: sttError // Hata bilgisini sonraki adıma taşı\n      }\n    }\n  ];\n}\n\n// Zaman sırasına göre sırala\nconst sortedWords = words.sort((a, b) => a.start - b.start);\n\nconst conversation = [];\nlet currentSpeaker = null;\nlet currentText = '';\nlet currentStart = null;\nlet currentEnd = null;\nlet conversationIndex = 0;\n\nfor (const word of sortedWords) {\n  const speaker = word.speaker_id === undefined || word.speaker_id === null ? 'unknown' : `speaker_${word.speaker_id}`;\n  const text = word.text || '';\n\n  if (speaker !== currentSpeaker) {\n    if (currentSpeaker !== null && currentText.trim() !== '') {\n      conversation.push({\n        speaker: currentSpeaker,\n        text: currentText.trim(),\n        start: currentStart,\n        end: currentEnd,\n        conversation_index: conversationIndex++\n      });\n    }\n    currentSpeaker = speaker;\n    currentText = text;\n    currentStart = word.start;\n    currentEnd = word.end;\n  } else {\n    currentText += ' ' + text;\n    currentEnd = word.end;\n  }\n}\n\nif (currentSpeaker !== null && currentText.trim() !== '') {\n  conversation.push({\n    speaker: currentSpeaker,\n    text: currentText.trim(),\n    start: currentStart,\n    end: currentEnd,\n    conversation_index: conversationIndex++\n  });\n}\n\nreturn [\n  {\n    json: {\n      callid: callid,\n      conversation: conversation\n    }\n  }\n];\n"
      },
