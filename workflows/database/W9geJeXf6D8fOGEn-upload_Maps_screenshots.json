      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Processed = 0, Report geçerli ve image alanı boş olanları filtrele\nconst filtered = items.filter(item => {\n    // Processed kontrolü\n    const processed = item.json.Processed;\n    const isNotProcessed = processed === 1 || processed === \"1\";\n\n\n    / image alanı boş veya null\n   const isImageEmpty = !item.json.image_name || item.json.image_name.trim() === \"null\" ||  item.json.image_name.trim() === \"\";\n    \n   const isImageurls=  $input.first().json[\"@image\"] !=\"wrong report url\" && $input.first().json[\"@image2\"] !=\"wrong report url\"\n\n    const ismanager = !item.json[\"Yönetici Adı\"] && $input.first().json[\"Yönetici Soyadı\"];\n    // Üç koşul da sağlanmalı\n  \n    // processed_maps_name alanı boş veya null\n    const isprocessed_maps_name = !item.json.processed_maps_name ||   item.json.processed_maps_name === \"null\";\n\n  \n    return isNotProcessed  && isprocessed_maps_name && ismanager && isImageEmpty ;\n});\n\n// Filtrelenmiş sonuçlardan ilk 20 kaydı al\nconst first20 = filtered.slice(0, 20);\n\nreturn first20;\n\n"
      },
