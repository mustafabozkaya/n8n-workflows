        "jsCode": "// Hata durumunda oluşan verileri işleyen fonksiyon\nconst item = $input.first();\nconst callId = item.json.callid || 'unknown';\n\n// Hata bilgisini logla\nconsole.log(`İşleme hatası: CallID=${callId}, Hata=${JSON.stringify(item.json.error || 'Bilinmeyen hata')}`); \n\n// Durumu hatalı olarak işaretle ama işlenmiş say\nreturn [\n  {\n    json: {\n      callid: callId,\n      processed: true,\n      error: true,\n      error_message: 'Speech-to-text işlemi sırasında hata oluştu'\n    }\n  }\n];"
