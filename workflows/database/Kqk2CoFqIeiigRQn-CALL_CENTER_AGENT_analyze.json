      "parameters": {
        "jsCode": "const item = $input.first();\nconst fileName = item.json.url || '';\nlet callDirection = '';\nif (fileName.toLowerCase().includes('inbound')) { callDirection = 'inbound'; }\nelse if (fileName.toLowerCase().includes('outbound')) { callDirection = 'outbound'; }\nelse { callDirection = 'inbound'; }\nreturn [{ json: { ...item.json, callDirection }, binary: item.binary }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
