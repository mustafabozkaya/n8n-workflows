    {
      "parameters": {
        "jsCode": "// Elevanlabs STT'den words değerini al\nlet words = [];\ntry {\n  const elevanlabsOutput = $('elevanlabs STT').first().json;\n  if (elevanlabsOutput && elevanlabsOutput.words && Array.isArray(elevanlabsOutput.words)) {\n    words = elevanlabsOutput.words;\n  } else {\n    console.log('Uyarı: elevanlabs STT çıktısında words dizisi bulunamadı veya array değil');\n  }\n} catch (error) {\n  console.log('Hata: elevanlabs STT çıktısı alınamadı:', error.message);\n}\n\n// Çağrı ID'sini al\nlet callid = 'unknown';\ntry {\n  callid = $('get call file').first().json.callid || 'unknown';\n} catch (error) {\n  console.log('Uyarı: callid alınamadı:', error.message);\n}\n\n// Words dizisi boşsa boş sonuç döndür\nif (!words.length) {\n  return [\n    {\n      json: {\n        callid: callid,\n        conversation: [],\n        error: 'Transkripsiyon verisi bulunamadı'\n      }\n    }\n  ];\n}\n\n// Zaman sırasına göre sırala\nconst sortedWords = words.sort((a, b) => a.start - b.start);\n\nconst conversation = [];\nlet currentSpeaker = null;\nlet currentText = '';\nlet currentStart = null;\nlet currentEnd = null;\nlet conversationIndex = 0;\n\nfor (const word of sortedWords) {\n  const speaker = word.speaker_id || 'unknown';\n  const text = word.text || '';\n\n  if (speaker !== currentSpeaker) {\n    if (currentSpeaker !== null) {\n      conversation.push({\n        speaker: currentSpeaker,\n        text: currentText.trim(),\n        start: currentStart,\n        end: currentEnd,\n        conversation_index: conversationIndex++\n      });\n    }\n\n    // Yeni konuşmacı başlat\n    currentSpeaker = speaker;\n    currentText = text;\n    currentStart = word.start;\n    currentEnd = word.end;\n  } else {\n    currentText += ' ' + text;\n    currentEnd = word.end;\n  }\n}\n\n// Son bloğu ekle\nif (currentText.trim()) {\n  conversation.push({\n    speaker: currentSpeaker,\n    text: currentText.trim(),\n    start: currentStart,\n    end: currentEnd,\n    conversation_index: conversationIndex++\n  });\n}\n\nreturn [\n  {\n    json: {\n      callid: callid,\n      conversation: conversation\n    }\n  }\n];\n"
      },
