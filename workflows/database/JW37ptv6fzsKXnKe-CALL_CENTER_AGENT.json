      "parameters": {
        "jsCode": "// Basic LLM Chain çıktısını düzgün JSON'a dönüştür\nlet item;\ntry {\n  item = $input.first();\n} catch (error) {\n  console.log('Input alınamadı:', error.message);\n  return [{\n    json: {\n      error: 'İşlem yapılamadı',\n      callid: 'unknown'\n    }\n  }];\n}\n\n// Çağrı ID'sini al\nlet callid = 'unknown';\ntry {\n  callid = $('get call file').first().json.callid || $('get conversation').first().json.callid || 'unknown';\n} catch (error) {\n  console.log('CallID bulunamadı:', error.message);\n}\n\nlet output = {};\n\nif (item.json && item.json.text) {\n  let responseText = item.json.text;\n  \n  // Markdown JSON formatını temizle\n  if (responseText.includes('```json')) {\n    responseText = responseText.replace(/```json\\n|```/g, '');\n  }\n  \n  try {\n    // JSON olarak parse et\n    output = JSON.parse(responseText);\n  } catch (error) {\n    console.log('JSON parse hatası:', error.message);\n    output = {\n      error: 'JSON parse hatası',\n      raw_text: responseText\n    };\n  }\n}\n\n// callid ekleyerek döndür\nreturn [{\n  json: {\n    ...output,\n    callid: callid\n  }\n}];"
      },
