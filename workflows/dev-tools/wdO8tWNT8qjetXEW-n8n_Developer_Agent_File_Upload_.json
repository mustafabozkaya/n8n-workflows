      "id": "a1b2c3d4-5e6f-7g8h-9i0j-1k2l3m4n5o6p",
      "name": "Check File Upload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "text",
        "options": {}
      },
      "id": "b2c3d4e5-6f7g-8h9i-0j1k-2l3m4n5o6p7q",
      "name": "Extract File Content",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Kullanıcı sorgusunu al\nconst userQuery = $input.first().json.body.query || '';\n\n// Dosya içeriğini al (varsa)\nlet fileContent = '';\nif ($input.first().json.body.file) {\n  // Dosya yüklenmişse, önceki adımdan gelen içeriği kullan\n  const previousData = $input.all();\n  for (const item of previousData) {\n    if (item.json.text) {\n      fileContent = item.json.text;\n      break;\n    }\n  }\n}\n\n// Sorguyu ve dosya içeriğini birleştir\nlet combinedQuery = userQuery;\nif (fileContent) {\n  combinedQuery = `${userQuery} - Dosya İçeriği: ${fileContent}`;\n}\n\n// URL'leri ayıkla\nconst urlRegex = /https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)/g;\nconst urls = [];\nconst urlMatches = combinedQuery.match(urlRegex);\nif (urlMatches) {\n  urls.push(...urlMatches);\n}\n\n// Zenginleştirilmiş sorguyu oluştur\nconst enrichedQuery = `n8n developer agent tarafından iyileştirilmiş sorgu: ${combinedQuery}`;\n\n// Sonuç formatını oluştur\nconst result = {\n  query: enrichedQuery,\n  sources: urls\n};\n\nreturn result;"
      },
      "id": "c3d4e5f6-7g8h-9i0j-1k2l-3m4n5o6p7q8r",
      "name": "Process and Combine Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sadece kullanıcı sorgusunu işle (dosya yok)\nconst userQuery = $json.body.query || '';\n\n// URL'leri ayıkla\nconst urlRegex = /https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)/g;\nconst urls = [];\nconst urlMatches = userQuery.match(urlRegex);\nif (urlMatches) {\n  urls.push(...urlMatches);\n}\n\n// Zenginleştirilmiş sorguyu oluştur\nconst enrichedQuery = `n8n developer agent tarafından iyileştirilmiş sorgu: ${userQuery}`;\n\n// Sonuç formatını oluştur\nconst result = {\n  query: enrichedQuery,\n  sources: urls\n};\n\nreturn result;"
      },
      "id": "d4e5f6g7-8h9i-0j1k-2l3m-4n5o6p7q8r9s",
      "name": "Process Query Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        400
      ]
    },
