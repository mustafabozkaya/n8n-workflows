      "id": "0ec9242d-0a2e-4f0b-8c59-fa6046f96e41",
      "name": "Read Business List from Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Function to normalize and hash data\nfunction hashData(data, type) {\n  if (!data) return null;\n  \n  let normalized;\n  \n  if (type === 'email') {\n    // Normalize email: lowercase and trim\n    normalized = data.toString().toLowerCase().trim();\n  } else if (type === 'phone') {\n    // Normalize phone: remove spaces, dashes, parentheses, and other non-numeric characters\n    normalized = data.toString().replace(/[\\s\\-\\(\\)\\+]/g, '');\n  } else {\n    normalized = data.toString().trim();\n  }\n  \n  // Hash with SHA256\n  return crypto.createHash('sha256').update(normalized).digest('hex');\n}\n\n// Process all items\nconst outputItems = [];\n\nfor (const item of $input.all()) {\n  const hashedItem = {\n    ...item.json\n  };\n  \n  // Hash email if present\n  if (item.json.email) {\n    hashedItem.hashedEmail = hashData(item.json.email, 'email');\n  }\n  \n  // Hash phone if present\n  if (item.json.phone) {\n    hashedItem.hashedPhone = hashData(item.json.phone, 'phone');\n  }\n  \n  outputItems.push(hashedItem);\n}\n\nreturn outputItems;"
      },
      "id": "92ffa243-f8cb-4f79-9991-69e7b977bfcd",
      "name": "Hash Customer Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $('Workflow Configuration').first().json.metaAdAccountId }}/customaudiences",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $('Workflow Configuration').first().json.metaAccessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": {{ $('Workflow Configuration').first().json.audienceName }},\n  \"subtype\": \"CUSTOM\",\n  \"customer_file_source\": \"USER_PROVIDED_ONLY\"\n}",
        "options": {}
      },
      "id": "52c162e3-9ed7-4da0-9a39-2d3371fe7aa2",
      "name": "Create Custom Audience",
