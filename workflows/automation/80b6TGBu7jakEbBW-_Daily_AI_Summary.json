    {
      "parameters": {
        "jsCode": "// Get the output text from the previous node\nconst outputText = $input.first().json.output;\n\n// Maximum chunk size for Telegram messages\nconst MAX_CHUNK_SIZE = 4000;\n\n// Split the text into chunks\nconst chunks = [];\nlet currentPosition = 0;\n\nwhile (currentPosition < outputText.length) {\n  // Get the next chunk\n  let chunk = outputText.substring(currentPosition, currentPosition + MAX_CHUNK_SIZE);\n  \n  // If this isn't the last chunk and doesn't end at the end of the text,\n  // try to break at a newline or space to avoid cutting words\n  if (currentPosition + MAX_CHUNK_SIZE < outputText.length) {\n    const lastNewline = chunk.lastIndexOf('\\n');\n    const lastSpace = chunk.lastIndexOf(' ');\n    \n    // Prefer breaking at newline, then space\n    if (lastNewline > MAX_CHUNK_SIZE * 0.8) {\n      chunk = chunk.substring(0, lastNewline + 1);\n    } else if (lastSpace > MAX_CHUNK_SIZE * 0.8) {\n      chunk = chunk.substring(0, lastSpace + 1);\n    }\n  }\n  \n  chunks.push({ text: chunk.trim() });\n  currentPosition += chunk.length;\n}\n\n// Return array of items, one for each chunk\nreturn chunks;"
      },
